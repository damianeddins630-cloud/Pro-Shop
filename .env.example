# Auth (recommended in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Public site URL (used for Shopify return links)
NEXT_PUBLIC_SITE_URL=https://pro-shop-lemon.vercel.app

# Durable inventory + accounts (required on Vercel so changes stick for everyone)
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=damianeddins630-cloud/Pro-Shop
GITHUB_BRANCH=main

# Optional alternative: Upstash Redis
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Optional alternate durable store (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=
# BBA_STORE_BLOB_URL=

# Shopify checkout-only — website keeps products/inventory; Shopify collects payment
# Preferred: Client ID + Client Secret (auto-refreshes Admin token)
# App scopes REQUIRED: write_draft_orders, read_draft_orders, read_orders
SHOPIFY_STORE_DOMAIN=ballards-bowling.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxx
SHOPIFY_API_VERSION=2025-01

# Same secret can be used for webhook HMAC verification
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxx

# Optional legacy static Admin token (not needed if CLIENT_ID/SECRET are set)
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxx
