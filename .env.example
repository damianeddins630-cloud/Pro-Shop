# Auth (required in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Public site URL (used for Shopify return links)
NEXT_PUBLIC_SITE_URL=https://pro-shop-lemon.vercel.app

# Durable inventory + accounts (required on Vercel so changes stick for everyone)
# Easiest: GitHub personal access token with "repo" scope
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=damianeddins630-cloud/Pro-Shop
GITHUB_BRANCH=main

# Optional alternative: Upstash Redis
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Optional alternate durable store (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=
# BBA_STORE_BLOB_URL=

# Shopify checkout-only — website keeps products/inventory; Shopify collects payment
# Create a custom app in Shopify Admin → Settings → Apps → Develop apps
# Enable Admin API scopes: write_draft_orders, read_draft_orders, read_orders
# Do NOT migrate products into Shopify. No Storefront API token needed.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxx
SHOPIFY_API_VERSION=2025-01

# REQUIRED for inventory after payment:
# Webhook topic orders/paid → https://YOUR-DOMAIN/api/shopify/webhook
# Use the app Client secret / webhook signing secret
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret
